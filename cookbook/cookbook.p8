pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- pico-8 cookbook
-- by shalone cason
-- every recipe is one small
-- playable example. read
-- cookbook.md beside this
-- cart for the why.
--
-- tab 0 the recipe book
-- tab 1 helpers
-- tab 2 moving things (1-7)
-- tab 3 lists, aim, camera (8-12)
-- tab 4 timers, text, color,
--       sound, saving (13-17)
-- tab 5 numbers, worlds (18-19)

cartdata("sdcason_cookbook")
r={}
pg,sel=0,1

-- add a recipe: name, hint,
-- and its 3 functions
function rec(n,h,i,u,d)
 add(r,{n=n,h=h,i=i,u=u,d=d})
end

function go(n)
 pg=(n-1)%#r+1 sel=pg
 camera() pal() fillp() music(-1)
 r[pg].i()
end

-- the pause menu (enter / p)
menuitem(1,"recipe list",function() pg=0 camera() music(-1) end)
menuitem(2,"next recipe",function() go(pg+1) end)
menuitem(3,"last recipe",function() go(pg-1) end)

function _update()
 if pg==0 then
  if btnp(2) then sel-=1 sfx(8) end
  if btnp(3) then sel+=1 sfx(8) end
  sel=(sel-1)%#r+1
  if btnp(4) or btnp(5) then go(sel) end
 else
  r[pg].u()
 end
end

function _draw()
 cls(1)
 if pg==0 then
  rectfill(0,0,127,7,0)
  print("pico-8 cookbook",1,1,10)
  print("z: open",99,1,6)
  for i=1,#r do
   local on=i==sel
   print((i<10 and " " or "")..i.." "..r[i].n,4,2+i*6,on and 10 or 6)
  end
  print("in a recipe, enter = menu",14,123,5)
 else
  r[pg].d()
  camera() pal() fillp()
  rectfill(0,0,127,6,0)
  print(pg..". "..r[pg].n,1,1,10)
  rectfill(0,121,127,127,0)
  print(r[pg].h,1,122,6)
 end
end

-->8
-- helpers (used by many recipes)

-- arrow keys as a direction
function arrows(s)
 local dx,dy=0,0
 if btn(0) then dx=-s end
 if btn(1) then dx=s end
 if btn(2) then dy=-s end
 if btn(3) then dy=s end
 return dx,dy
end

-- is the map tile under x,y
-- a wall? (sprite flag 0)
function wall(x,y)
 return fget(mget(x\8,y\8),0)
end

-- does a 6x6 box at x,y
-- touch a wall? check corners
function solid(x,y)
 return wall(x,y) or wall(x+5,y)
  or wall(x,y+5) or wall(x+5,y+5)
end

-- build a map from strings:
-- "#" = brick, "=" = grass
function make_map(rows)
 for y=0,15 do
  for x=0,15 do
   local c=sub(rows[y] or "",x+1,x+1)
   mset(x,y,c=="#" and 46 or c=="=" and 47 or 0)
  end
 end
end

function oprint(s,x,y,c)
 for i=-1,1 do
  for j=-1,1 do print(s,x+i,y+j,0) end
 end
 print(s,x,y,c)
end

function cprint(s,y,c)
 print(s,64-#s*2,y,c)
end

function white()
 for i=1,15 do pal(i,7) end
end

-- particles: add, move, draw
function burst(l,x,y,n,cs)
 for i=1,n do
  local a,s=rnd(),rnd(2)
  add(l,{x=x,y=y,dx=cos(a)*s,dy=sin(a)*s,t=20+rnd(20),c=rnd(cs)})
 end
end

function pmove(l)
 for p in all(l) do
  p.x+=p.dx p.y+=p.dy
  p.dy+=.05 p.t-=1
  if p.t<0 then del(l,p) end
 end
end

function pdraw(l)
 for p in all(l) do
  pset(p.x,p.y,p.t<8 and 5 or p.c)
 end
end

-->8
-- moving things

rec("the game loop","_update moves, _draw paints",
function() bx,by,bdx,bdy,fr=20,30,1.5,1,0 end,
function()
 fr+=1
 bx+=bdx by+=bdy
 if bx<4 or bx>123 then bdx=-bdx sfx(8) end
 if by<12 or by>116 then bdy=-bdy sfx(8) end
end,
function()
 circfill(bx,by,4,10)
 print("frames so far: "..fr,4,100,6)
 print("30 frames every second",4,108,6)
end)

rec("move + diagonals","arrows. x: fix the diagonal",
function() px,py,fix,sp=60,60,false,0 end,
function()
 local dx,dy=0,0
 if btn(0) then dx-=1 end
 if btn(1) then dx+=1 end
 if btn(2) then dy-=1 end
 if btn(3) then dy+=1 end
 if btnp(5) then fix=not fix end
 -- .707 = 1 divided by the
 -- square root of 2
 if fix and dx!=0 and dy!=0 then
  dx*=.707 dy*=.707
 end
 px=mid(0,px+dx*1.5,120)
 py=mid(8,py+dy*1.5,112)
 sp=sqrt(dx*dx+dy*dy)*1.5
end,
function()
 spr(48+t()*6%2,px,py)
 print("speed "..sp,4,100,6)
 print(fix and "diagonal fixed" or "diagonal too fast!",4,108,fix and 11 or 8)
end)

rec("speed + sliding","arrows push. x: ice or grass",
function() px,py,vx,vy,ice=60,60,0,0,false end,
function()
 local dx,dy=arrows(.2)
 vx+=dx vy+=dy
 if btnp(5) then ice=not ice end
 -- friction: keep 97% or 80%
 -- of the speed every frame
 local f=ice and .97 or .8
 vx*=f vy*=f
 px+=vx py+=vy
 if px<0 or px>120 then vx=-vx px=mid(0,px,120) end
 if py<8 or py>112 then vy=-vy py=mid(8,py,112) end
end,
function()
 rectfill(0,7,127,120,ice and 12 or 3)
 spr(48,px,py)
 print(ice and "ice: keep 97%" or "grass: keep 80%",4,112,7)
end)

rec("sprites + animation","arrows walk. up/down: size",
function() px,face,sc,fr=56,1,1,0 end,
function()
 local m=false
 if btn(0) then px-=1 face=-1 m=true end
 if btn(1) then px+=1 face=1 m=true end
 if btnp(2) then sc=min(sc+1,4) end
 if btnp(3) then sc=max(sc-1,1) end
 if m then fr+=.15 end
 px=mid(0,px,127)
end,
function()
 for i=0,2 do
  spr(i*2,4+i*24,12,2,2)
  print(i*2,9+i*24,30,6)
 end
 local f=flr(fr)%2*2
 local w=16*sc
 sspr(f*8,0,16,16,px-w/2,110-w,w,w,face<0)
 line(0,110,127,110,5)
 print("frame "..f.." flip "..tostr(face<0).." x"..sc,4,113,7)
end)

rec("bumping boxes","arrows move the yellow box",
function()
 px,py=10,60
 boxes={{30,24,24,14},{76,30,12,40},{40,80,44,10}}
end,
function()
 local dx,dy=arrows(1)
 px+=dx py+=dy
end,
function()
 for b in all(boxes) do
  local x,y,w,h=unpack(b)
  -- 4 checks = boxes overlap
  local hit=px<x+w and px+8>x and py<y+h and py+8>y
  rectfill(x,y,x+w-1,y+h-1,hit and 8 or 13)
 end
 rectfill(px,py,px+7,py+7,10)
end)

rec("walls from the map","arrows: slide along walls",
function()
 make_map({"################",
 "#..............#",
 "#..###.....#...#",
 "#....#.....#...#",
 "#....#..####...#",
 "#..............#",
 "#.####....#....#",
 "#.........#..###",
 "#....###..#....#",
 "#......#.......#",
 "#......#..###..#",
 "#..............#",
 "#..............#",
 "################"})
 px,py=12,18
end,
function()
 local dx,dy=arrows(1)
 -- one axis at a time, so a
 -- wall stops one and not
 -- the other: you slide
 if not solid(px+dx,py) then px+=dx end
 if not solid(px,py+dy) then py+=dy end
end,
function()
 map()
 spr(48,px-1,py-2)
end)

rec("jump like a pro","arrows run. z: jump (hold=high)",
function()
 make_map({[9]="......====......",
 [12]="===......=======",
 [13]="################",
 [14]="################"})
 px,py,vy,ground,coy,buf=12,80,0,false,0,0
end,
function()
 mvx=arrows(1.2)
 if not solid(px+mvx,py) then px+=mvx end
 px=mid(0,px,122)
 -- jump buffer: a press counts
 -- for 6 frames
 if btnp(4) then buf=6 else buf=max(buf-1,0) end
 -- coyote time: you may still
 -- jump 6 frames after a ledge
 if ground then coy=6 else coy=max(coy-1,0) end
 if buf>0 and coy>0 then
  vy,buf,coy=-3.2,0,0 sfx(3)
 end
 vy=min(vy+.25,4)
 -- let go early: fall sooner
 if not btn(4) and vy<0 then vy+=.3 end
 ground=false
 if solid(px,py+vy) then
  if vy>0 then ground=true end
  -- step 1 pixel at a time
  -- until we touch it
  for i=1,4 do
   if solid(px,py+sgn(vy)) then break end
   py+=sgn(vy)
  end
  vy=0
 else
  py+=vy
 end
end,
function()
 map()
 spr(48+(ground and mvx!=0 and t()*8%2 or 0),px-1,py-2)
 print("coyote "..coy.."  buffer "..buf,4,10,7)
end)

-->8
-- lists, aim, camera

rec("lists of things","z: fireworks! (add and del)",
function() parts={} end,
function()
 if btnp(4) then
  burst(parts,20+rnd(88),20+rnd(60),40,split"8,9,10,11,12,14")
  sfx(2)
 end
 pmove(parts)
end,
function()
 pdraw(parts)
 print("things in the list: "..#parts,4,112,7)
end)

rec("aim with atan2","z: fire at the helicopter",
function() bul,ang,hits={},0,0 end,
function()
 hx,hy=64+cos(t()/6)*50,60+sin(t()/4)*30
 -- atan2 gives the angle from
 -- the turret to the target
 ang=atan2(hx-64,hy-64)
 if btnp(4) then
  add(bul,{x=64,y=64,dx=cos(ang)*3,dy=sin(ang)*3})
  sfx(7)
 end
 for b in all(bul) do
  b.x+=b.dx b.y+=b.dy
  if abs(b.x-hx)<4 and abs(b.y-hy)<4 then
   del(bul,b) hits+=1 sfx(2)
  elseif b.x<0 or b.x>128 or b.y<0 or b.y>128 then
   del(bul,b)
  end
 end
end,
function()
 circfill(64,64,5,5)
 line(64,64,64+cos(ang)*10,64+sin(ang)*10,7)
 spr(33+t()*10%2,hx-4,hy-4)
 for b in all(bul) do circfill(b.x,b.y,1,10) end
 print("angle "..ang.." (in turns)",4,104,6)
 print("hits "..hits,4,112,7)
end)

rec("chase + run away","arrows. hold x: be scary",
function()
 px,py,tanks=64,64,{}
 for i=1,6 do add(tanks,{x=rnd(128),y=10+rnd(100)}) end
end,
function()
 local dx,dy=arrows(1.2)
 px,py=mid(0,px+dx,120),mid(8,py+dy,112)
 for e in all(tanks) do
  local a=atan2(px-e.x,py-e.y)
  -- same angle: plus = chase,
  -- minus = run away
  local s=btn(5) and -.8 or .4
  e.x=mid(0,e.x+cos(a)*s,120)
  e.y=mid(8,e.y+sin(a)*s,112)
 end
end,
function()
 for e in all(tanks) do spr(32,e.x,e.y,1,1,e.x>px) end
 spr(btn(5) and 4 or 0,px-4,py-8,2,2)
end)

rec("camera + hud","arrows explore a big world",
function() px,py,cx,cy=256,256,192,192 end,
function()
 local dx,dy=arrows(2)
 px,py=mid(0,px+dx,504),mid(0,py+dy,504)
 -- ease: move 10% of the way
 -- to the goal every frame
 cx+=(px-64-cx)*.1 cy+=(py-64-cy)*.1
end,
function()
 camera(cx,cy)
 rectfill(0,0,511,511,3)
 for x=0,511,32 do
  for y=0,511,32 do
   local s=split"37,6,8,10"[(x*7+y*13)\32%4+1]
   local w=s==37 and 1 or 2
   spr(s,x+8,y+8,w,w)
  end
 end
 spr(48,px,py)
 -- camera() = back to the
 -- screen for the hud
 camera()
 rectfill(96,9,127,40,0)
 pset(96+px/16,9+py/16,10)
 print("x "..flr(px).." y "..flr(py),2,113,7)
end)

rec("juice","z: hit it. x: juice on/off",
function() juice,sh,stop,fl,parts=true,0,0,0,{} end,
function()
 if stop>0 then stop-=1 return end
 if btnp(5) then juice=not juice end
 if btnp(4) then
  sfx(10)
  if juice then
   sh,stop,fl=5,4,3
   burst(parts,64,60,20,split"7,10,9")
  end
 end
 sh*=.8 fl-=1
 pmove(parts)
end,
function()
 camera(rnd(sh)-sh/2,rnd(sh)-sh/2)
 if fl>0 then white() end
 sspr(0,16,8,8,48,44,32,32)
 pal()
 pdraw(parts)
 camera()
 print(juice and "shake+freeze+flash: on" or "juice: off",4,112,juice and 11 or 8)
end)

-->8
-- timers, text, color, sound,
-- saving

rec("timers + states","z: fire (it has a cooldown)",
function() light,lt,cd,n="go",90,0,0 end,
function()
 -- a state machine: each state
 -- knows what comes next
 lt-=1
 if lt<=0 then
  if light=="go" then light,lt="slow",30
  elseif light=="slow" then light,lt="stop",90
  else light,lt="go",90 end
 end
 cd=max(cd-1,0)
 if btnp(4) and cd==0 then cd,n=45,n+1 sfx(7) end
end,
function()
 rectfill(16,20,40,76,0)
 circfill(28,32,7,light=="stop" and 8 or 2)
 circfill(28,48,7,light=="slow" and 10 or 4)
 circfill(28,64,7,light=="go" and 11 or 3)
 print("state: "..light,52,30,7)
 print("time left: "..lt,52,40,6)
 print("shots: "..n,52,60,7)
 rect(52,68,102,74,5)
 rectfill(53,69,53+48*(1-cd/45),73,cd==0 and 11 or 8)
end)

rec("text tricks","z: restart the typing",
function() tw=0 end,
function()
 tw+=.5
 if btnp(4) then tw=0 end
end,
function()
 oprint("outlined text",4,12,7)
 cprint("centered text",22,10)
 print(sub("the city is quiet...\ntoo quiet.",1,tw),4,34,11)
 local s="wavy letters!"
 for i=1,#s do
  print(sub(s,i,i),4+i*5,60+sin(t()+i/8)*3,8+i%7)
 end
 print("\^w\^tbig text",4,76,9)
 print("\#2 with a background ",4,96,7)
end)

rec("colors + patterns","z: new colors. x: pattern",
function() sw,pat=0,1 end,
function()
 if btnp(4) then sw+=1 end
 if btnp(5) then pat=pat%4+1 end
end,
function()
 for i=0,15 do
  rectfill(i*8,9,i*8+7,16,i)
  print(i%10,i*8+2,18,i==0 and 5 or i)
 end
 -- pal(old,new) swaps a color
 local c=split"11,8,12,14,9"
 pal(11,c[sw%5+1])
 sspr(0,0,16,16,8,40,48,48)
 pal()
 -- fillp: a 4x4 on/off pattern
 fillp(({0,0b0101101001011010,0b1000010000100001,0b1111000011110000})[pat])
 circfill(94,64,24,0x9a)
 fillp()
end)

rec("sound","up/down: pick. z: play x: music",
function() sn,mu=0,false end,
function()
 if btnp(2) then sn-=1 end
 if btnp(3) then sn+=1 end
 sn%=11
 if btnp(4) then sfx(sn) end
 if btnp(5) then
  mu=not mu
  music(mu and 0 or -1)
 end
end,
function()
 local names=split"stomp,zap,boom,pickup,hurt,roar,whoosh,shoot,blip,level up,crunch"
 for i=0,10 do
  print((i==sn and "> " or "  ")..i.." "..names[i+1],4,10+i*7,i==sn and 10 or 6)
 end
 print("music: "..(mu and "on" or "off"),80,10,mu and 11 or 5)
 for c=0,3 do
  print("ch"..c.." "..stat(46+c),80,24+c*7,stat(46+c)>=0 and 7 or 5)
 end
end)

rec("saving","z: add 1 (it saves!) x: reset",
function() end,
function()
 if btnp(4) then dset(0,dget(0)+1) sfx(3) end
 if btnp(5) then dset(0,0) end
end,
function()
 print("\^w\^t"..dget(0),56,40,10)
 print("turn pico-8 off and on:",4,80,6)
 print("this number will still be here",4,88,6)
end)

-->8
-- numbers, worlds

rec("number traps","hold z: count up fast",
function() n=32000 end,
function()
 if btn(4) then n+=10 end
 if btnp(5) then n=32000 end
end,
function()
 print("n = "..n,4,12,n<0 and 8 or 11)
 print("biggest number: 32767",4,20,6)
 print("past it, it wraps to minus!",4,28,6)
 print("sqrt(200*200) = "..sqrt(200*200),4,44,8)
 local d=200/16
 print("shrink first: "..sqrt(d*d)*16,4,52,11)
 print("-7%3 = "..-7%3,4,68,7)
 print("flr(-1.5) = "..flr(-1.5),4,76,7)
 print("7\\2 = "..7\2,4,84,7)
 print("1/3*3 = "..1/3*3,4,92,7)
 print("x: back to 32000",4,108,5)
end)

rec("random worlds","z: new seed  x: same again",
function() seed=1 end,
function()
 if btnp(4) then seed=flr(rnd(999)) end
end,
function()
 -- srand: same seed, same
 -- "random" numbers every time
 srand(seed)
 rectfill(0,7,127,120,3)
 for x=0,7 do
  for y=0,6 do
   local r=rnd()
   if r<.6 then
    spr(r<.15 and 37 or r<.35 and 6 or r<.5 and 8 or 10,x*16,9+y*16,r<.15 and 1 or 2,2)
   end
  end
 end
 srand(t())
 oprint("seed "..seed,90,112,7)
end)
