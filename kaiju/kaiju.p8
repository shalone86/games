pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- kaiju workshop
-- six ways to play one
-- monster game.
-- by shalone cason
-- (stand-in art + sounds:
--  redraw them all!)
--
-- tab 0 setup + game states
-- tab 1 the city
-- tab 2 the kaiju
-- tab 3 army + effects
-- tab 4 modes with buttons
-- tab 5 modes with no buttons
-- tab 6 drawing + hud

cartdata("sdcason_kaiju_ws")
world=384
st,sel="title",1
modes={}

-- building kinds, by k+1:
-- 0 tree 1 house 2 office 3 tower
bhp=split"1,1,3,6"
bpts=split"1,10,25,50"
bspr=split"37,6,8,10"

function _update()
 if st=="title" then upd_title()
 elseif st=="play" then upd_play()
 else upd_over() end
end

function _draw()
 if st=="title" then drw_title()
 else drw_play() end
end

function upd_title()
 if btnp(2) then sel-=1 sfx(8) end
 if btnp(3) then sel+=1 sfx(8) end
 sel=(sel-1)%#modes+1
 if btnp(4) or btnp(5) then start(sel) end
end

function start(n)
 mi,mode=n,modes[n]
 make_city()
 k={x=world/2,y=world/2,vx=0,vy=0,
  fx=1,fy=0,face=1,fr=0,z=0,
  hp=10,mhp=10,sz=1,inv=0}
 ens,shots,fx,pops,drops,objs={},{},{},{},{},{}
 score,tm,secs,shake,stop=0,0,0,0,0
 spawn_t,wave,bt=60,1,0
 cx,cy=k.x-64,k.y-64
 if mode.init then mode.init() end
 st="play"
 -- music on channels 0+1,
 -- sound effects use 2+3
 music(0,0,3)
end

function over()
 st,ot="over",0
 music(-1) sfx(2)
 boom(k.x,k.y-8,40)
 best=dget(mi)
 if score>best then dset(mi,score) end
end

function upd_over()
 ot+=1
 upd_fx()
 if ot>45 and (btnp(4) or btnp(5)) then
  st="title"
 end
end

-->8
-- the city

-- blocks of 3x3 lots with a
-- road around each block
function make_city()
 blds={}
 for bx=0,world-1,64 do
  for by=0,world-1,64 do
   for i=0,2 do
    for j=0,2 do
     local x,y,r=bx+16+i*16,by+16+j*16,rnd()
     local kd=r<.25 and 0 or r<.6 and 1 or r<.85 and 2 or 3
     -- leave some lots empty, and
     -- a clear spot in the middle
     if r<.93 and dist(x+8,y+8,world/2,world/2)>40 then
      add(blds,{x=x,y=y,k=kd,hp=bhp[kd+1],fl=0})
     end
    end
   end
  end
 end
end

-- distance that can't overflow:
-- 200*200 is past 32767, so
-- shrink first, grow after
function dist(x1,y1,x2,y2)
 local dx,dy=(x2-x1)/16,(y2-y1)/16
 return sqrt(dx*dx+dy*dy)*16
end

-- first building touching the
-- kaiju's feet at x,y (or nil)
function bump(x,y)
 local r=4*k.sz
 for b in all(blds) do
  if not b.dead then
   local h=b.k==0 and 3 or 7
   if abs(x-b.x-8)<h+r and abs(y-b.y-8)<h+r then
    return b
   end
  end
 end
end

function smash(b)
 b.dead=true
 addscore(bpts[b.k+1],b.x+8,b.y)
 boom(b.x+8,b.y+8,b.k*4+3)
 shake=max(shake,b.k)
 sfx(b.k<2 and 10 or 2)
 drop(b.x+8,b.y+8)
 if mode.smash then mode.smash(b) end
end

-- hurt everything in a box
-- around x,y. eo = enemies
-- only. returns how many hit.
function hit(x,y,r,d,eo)
 local n=0
 if not eo then
  for b in all(blds) do
   if not b.dead and abs(b.x+8-x)<r+6 and abs(b.y+8-y)<r+6 then
    n+=1 b.hp-=d b.fl=4
    if b.hp<=0 then smash(b) end
   end
  end
 end
 for e in all(ens) do
  if abs(e.x-x)<r+3 and abs(e.y-y)<r+3 then
   n+=1 e.hp-=d e.fl=4
   if e.hp<=0 then kill(e) end
  end
 end
 return n
end

-->8
-- the kaiju

function upd_play()
 -- hit-stop: freeze a few
 -- frames on big hits
 if stop>0 then stop-=1 return end
 -- count frames 0-29, then a
 -- second. (a frame count
 -- would pass 32767 in 18 min)
 tm+=1
 if tm==30 then
  tm,secs=0,secs+1
  if secs%30==0 then
   wave+=1 banner("wave "..wave.."!")
  end
 end

 local ix,iy=0,0
 if btn(0) then ix=-1 end
 if btn(1) then ix=1 end
 if btn(2) then iy=-1 end
 if btn(3) then iy=1 end
 -- diagonals: same speed
 if ix!=0 and iy!=0 then
  ix*=.707 iy*=.707
 end
 if ix!=0 or iy!=0 then
  k.fx,k.fy=ix,iy
  if ix!=0 then k.face=sgn(ix) end
  k.fr+=.15
 end
 -- fric 0 = stop at once,
 -- .97 = slide like on ice
 local fric,acc=mode.fric or 0,mode.acc or 1.2
 k.vx=k.vx*fric+ix*acc
 k.vy=k.vy*fric+iy*acc

 k.atk,k.safe=false,k.z>0
 k.inv=max(k.inv-1,0)
 mode.upd()
 move_k()
 upd_army()
 upd_fx()
 for d in all(drops) do
  if abs(d.x-k.x)<8*k.sz and abs(d.y-k.y)<8*k.sz then
   del(drops,d) sfx(3)
   if d.s==40 then heal() else mode.gem() end
  end
 end
end

-- move one axis at a time so
-- the kaiju slides along walls
function move_k()
 local b=mode.bounce or 0
 if k.z>0 or bump(k.x,k.y) then
  -- flying, or stuck inside:
  -- move freely
  k.x+=k.vx k.y+=k.vy
 else
  if not try(k.x+k.vx,k.y) then k.vx*=-b end
  if not try(k.x,k.y+k.vy) then k.vy*=-b end
 end
 k.x,k.y=mid(8,k.x,world-8),mid(12,k.y,world-4)
end

function try(x,y)
 local b=bump(x,y)
 if b and not crush(b) then return false end
 k.x,k.y=x,y
 return true
end

-- walking into a building:
-- trees always break, the
-- mode decides the rest
function crush(b)
 if b.k==0 or mode.crush and mode.crush(b) then
  smash(b) return true
 end
end

function hurt(n)
 if k.safe or k.inv>0 then return end
 k.inv,shake=30,4
 sfx(4)
 if mode.hurt then mode.hurt(n) else k.hp-=n end
 if k.hp<=0 then over() end
end

function heal()
 if mode.heal then mode.heal()
 else k.hp=min(k.hp+2,k.mhp) end
 add(pops,{x=k.x,y=k.y-20,t=30,s="yum!"})
end

-->8
-- army + effects

function spawn()
 local a=rnd()
 local e={x=mid(4,k.x+cos(a)*90,world-4),
  y=mid(4,k.y+sin(a)*90,world-4),
  kd=rnd()<.15+wave*.07 and 2 or 1,
  cd=60+rnd(60),fl=0,stun=0}
 e.hp=e.kd
 add(ens,e)
end

function upd_army()
 spawn_t-=1
 if spawn_t<=0 and #ens<3+wave*2 then
  spawn() spawn_t=max(20,100-wave*12)
 end
 for e in all(ens) do
  local d,a=dist(e.x,e.y,k.x,k.y),atan2(k.x-e.x,k.y-e.y)
  e.fl=max(e.fl-1,0)
  if e.stun>0 then
   e.stun-=1
  else
   -- tanks (kd 1) crawl,
   -- helis (kd 2) circle
   local s=e.kd*.3
   if d>36 then
    e.x+=cos(a)*s e.y+=sin(a)*s
   elseif e.kd==2 then
    e.x+=cos(a+.25)*s e.y+=sin(a+.25)*s
   end
   e.cd-=1
   if e.cd<=0 and d<80 then
    e.cd=100+rnd(60)
    add(shots,{x=e.x,y=e.y,dx=cos(a),dy=sin(a),t=100,s=34+e.kd})
    sfx(7)
   end
  end
  if d<7*k.sz and k.z==0 and mode.eat and mode.eat(e) then
   kill(e)
  end
 end
 for s in all(shots) do
  if s.s==36 then
   -- missiles steer a little
   local a=atan2(k.x-s.x,k.y-8-s.y)
   s.dx=s.dx*.98+cos(a)*.04
   s.dy=s.dy*.98+sin(a)*.04
  end
  s.x+=s.dx s.y+=s.dy s.t-=1
  if s.t<0 then
   del(shots,s)
  elseif abs(s.x-k.x)<5*k.sz and abs(s.y-k.y+7*k.sz)<7*k.sz then
   del(shots,s) boom(s.x,s.y,5) hurt(1)
  end
 end
end

function kill(e)
 del(ens,e)
 boom(e.x,e.y,12)
 addscore(e.kd*20,e.x,e.y)
 drop(e.x,e.y)
 sfx(2)
end

-- sometimes leave a heart,
-- or a gem if the mode uses them
function drop(x,y)
 local r=rnd()
 if r<.06 then add(drops,{x=x,y=y,s=40})
 elseif mode.gem and r<.45 then add(drops,{x=x,y=y,s=39}) end
end

function boom(x,y,n)
 for i=1,n do
  add(fx,{x=x,y=y,dx=rnd(3)-1.5,dy=rnd(3)-2,
   t=10+rnd(15),c=rnd(split"7,10,9,8,5")})
 end
end

-- a shockwave circle
function ring(x,y,r,c)
 add(fx,{x=x,y=y,dx=0,dy=0,t=10,r=r,c=c})
end

function upd_fx()
 for p in all(fx) do
  p.x+=p.dx p.y+=p.dy
  p.dx*=.9 p.dy*=.9
  p.t-=1
  if p.t<0 then del(fx,p) end
 end
 for p in all(pops) do
  p.y-=.5 p.t-=1
  if p.t<0 then del(pops,p) end
 end
end

-- numbers stop at 32767,
-- so never go past 32000
function addscore(n,x,y)
 score=min(score+n,32000)
 if n>=10 then add(pops,{x=x,y=y,t=30,s="+"..n}) end
end

function banner(s) bn,bt=s,60 end

-->8
-- modes with attack buttons
-- each mode is a table:
--  name, desc: title screen
--  init(): set up its stuff
--  upd(): every frame
--  drw(): extra drawing
--  hud(): bottom bar
-- optional: crush(b) eat(e)
--  hurt(n) heal() gem()
--  acc fric bounce nohp

-- 1. classic: stomp + beam
add(modes,{
 name="stomp + breath",
 desc="z: stomp the ground\nx: hold for atomic breath",
 init=function() k.en,k.cd,k.bl=60,0,0 end,
 upd=function()
  k.cd=max(k.cd-1,0)
  if btnp(4) and k.cd==0 then
   k.cd=18
   hit(k.x,k.y,14,2)
   ring(k.x,k.y,18,7)
   shake,stop=3,2
   sfx(0)
  end
  if btn(5) and k.en>0 then
   k.en-=1 k.atk=true
   k.vx*=.4 k.vy*=.4
   k.bl=min(k.bl+5,56)
   if tm%3==0 then
    for i=8,k.bl,8 do
     hit(k.x+k.fx*i,k.y-4+k.fy*i,4,1)
    end
   end
   if tm%6==0 then sfx(1) end
  else
   k.bl=0
   k.en=min(k.en+.4,60)
  end
 end,
 drw=function()
  if k.bl>0 then
   local mx,my=k.x+k.face*7,k.y-11
   for i=0,k.bl,3 do
    circfill(mx+k.fx*i,my+k.fy*i,1+rnd(2),12)
   end
   line(mx,my,mx+k.fx*k.bl,my+k.fy*k.bl,7)
  end
 end,
 hud=function() meter("breath",k.en/60,12) end
})

-- 2. grab things, throw them
add(modes,{
 name="grab + throw",
 desc="z: grab, then z: throw\nx: roar (stuns the army)",
 init=function() k.held,k.rc=nil,0 end,
 upd=function()
  k.rc=max(k.rc-1,0)
  k.atk=k.rc>130
  if btnp(4) then
   if k.held then
    add(objs,{x=k.x,y=k.y-18,dx=k.fx*4,dy=k.fy*4,t=18,s=k.held,w=k.hw})
    k.held=nil sfx(6)
   else
    grab()
   end
  end
  if btnp(5) and k.rc==0 then
   k.rc,shake=150,3 sfx(5)
   ring(k.x,k.y-8,48,8)
   for e in all(ens) do
    if dist(e.x,e.y,k.x,k.y)<48 then
     e.stun=120
     local a=atan2(e.x-k.x,e.y-k.y)
     e.x+=cos(a)*16 e.y+=sin(a)*16
    end
   end
   for s in all(shots) do
    if dist(s.x,s.y,k.x,k.y)<48 then del(shots,s) end
   end
  end
  for o in all(objs) do
   o.x+=o.dx o.y+=o.dy o.t-=1
   -- land at the end, or early
   -- if it touches an enemy
   if o.t<0 or hit(o.x,o.y+8,2,0,true)>0 then
    del(objs,o)
    hit(o.x,o.y+8,16,3)
    ring(o.x,o.y+8,20,9) boom(o.x,o.y+8,10)
    shake,stop=4,2 sfx(2)
   end
  end
 end,
 drw=function()
  if k.held then
   spr(k.held,k.x-k.hw*4,k.y-18-k.hw*8,k.hw,k.hw)
  end
  for o in all(objs) do
   spr(o.s,o.x-o.w*4,o.y-o.w*4,o.w,o.w)
  end
 end,
 hud=function()
  meter("roar",1-k.rc/150,8)
  if k.held then print("z: throw!",88,121,10) end
 end
})

-- grab what's in front of us:
-- an enemy, or a whole building
function grab()
 local gx,gy=k.x+k.fx*10,k.y+k.fy*10-4
 for e in all(ens) do
  if abs(e.x-gx)<12 and abs(e.y-gy)<12 then
   del(ens,e) addscore(20,e.x,e.y)
   k.held,k.hw=e.kd==1 and 32 or 33,1
   sfx(3) return
  end
 end
 for b in all(blds) do
  if not b.dead and b.k>0 and abs(b.x+8-gx)<12 and abs(b.y+8-gy)<12 then
   k.held,k.hw=bspr[b.k+1],2
   smash(b) return
  end
 end
end

-- 3. jump around, dash through
add(modes,{
 name="leap + dash",
 desc="z: leap over buildings\nx: dash through them",
 init=function() k.dash,k.dcd,k.jt=0,0,0 end,
 upd=function()
  k.dcd=max(k.dcd-1,0)
  if btnp(5) and k.dcd==0 and k.z==0 then
   k.dash,k.dcd=10,40 sfx(6)
  end
  if k.dash>0 then
   k.dash-=1 k.safe,k.atk=true,true
   k.vx,k.vy=k.fx*3.5,k.fy*3.5
   hit(k.x,k.y-4,8,2,true)
   add(fx,{x=k.x,y=k.y-8,dx=0,dy=0,t=6,c=9})
  end
  if btnp(4) and k.jt==0 then k.jt=1 sfx(6) end
  if k.jt>0 then
   -- a jump is half a sine wave
   k.jt+=1
   k.z=-sin(k.jt/60)*28
   if k.jt>=30 then
    k.jt,k.z=0,0
    -- squash whatever we land on
    local b=bump(k.x,k.y)
    while b do smash(b) b=bump(k.x,k.y) end
    hit(k.x,k.y,22,3)
    ring(k.x,k.y,26,7) ring(k.x,k.y,16,10)
    shake,stop=6,3 sfx(0)
   end
  end
 end,
 -- a dash does 3 damage: houses
 -- and offices break, towers
 -- stop you cold
 crush=function(b)
  if k.dash>0 then
   b.hp-=3 b.fl=4
   if b.hp>0 then k.dash,shake=0,3 end
   return b.hp<=0
  end
 end,
 hud=function() meter("dash",1-k.dcd/40,9) end
})

-->8
-- modes with no attack buttons

-- 4. weapons fire by themselves
add(modes,{
 name="survivor",
 desc="no attack buttons! weapons\nfire by themselves. get gems",
 init=function()
  k.lv,k.xp,k.need,k.zc,k.pc,k.ang=1,0,4,0,0,0
  -- weapon levels: zap,
  -- spores, pulse
  k.wz,k.ws,k.wp=1,1,0
 end,
 upd=function()
  -- zap the nearest enemy
  k.zc-=1
  if k.zc<=0 then
   k.zc=max(10,45-k.wz*7)
   local tg,td=nil,64
   for e in all(ens) do
    local d=dist(e.x,e.y,k.x,k.y)
    if d<td then tg,td=e,d end
   end
   if tg then
    add(objs,{x=tg.x,y=tg.y,t=5})
    hit(tg.x,tg.y,2+k.wz*2,1+k.wz\3,true)
    sfx(1)
   end
  end
  for o in all(objs) do
   o.t-=1
   if o.t<0 then del(objs,o) end
  end
  -- spores circle around us
  k.ang+=.012
  for i=1,k.ws do
   local sx,sy=spore(i)
   if tm%5==0 then hit(sx,sy,3,1) end
   for s in all(shots) do
    if abs(s.x-sx)<5 and abs(s.y-sy)<5 then del(shots,s) end
   end
  end
  -- a pulse every few seconds
  if k.wp>0 then
   k.pc-=1
   if k.pc<=0 then
    k.pc=max(40,130-k.wp*20)
    hit(k.x,k.y,16+k.wp*6,2)
    ring(k.x,k.y,20+k.wp*6,10)
    shake=2 sfx(0)
   end
  end
 end,
 crush=function(b) return b.k<2 end,
 eat=function(e) return e.kd==1 end,
 gem=function()
  k.xp+=1
  if k.xp>=k.need then
   k.lv+=1 k.xp=0 k.need+=2 sfx(9)
   local u=k.lv%3
   if u==0 then k.ws=min(k.ws+1,6) banner("more spores!")
   elseif u==1 then k.wz+=1 banner("faster zap!")
   else k.wp+=1 banner("bigger pulse!") end
  end
 end,
 drw=function()
  for i=1,k.ws do
   local sx,sy=spore(i)
   circfill(sx,sy,2,10) pset(sx,sy,7)
  end
  for o in all(objs) do
   bolt(k.x+k.face*6,k.y-12,o.x,o.y)
  end
 end,
 hud=function() meter("lv "..k.lv,k.xp/k.need,11) end
})

function spore(i)
 local a=k.ang+i/k.ws
 return k.x+cos(a)*20,k.y-6+sin(a)*14
end

-- zig-zag lightning
function bolt(x1,y1,x2,y2)
 local px,py=x1,y1
 for i=1,4 do
  local x,y=x1+(x2-x1)*i/4+rnd(6)-3,y1+(y2-y1)*i/4+rnd(6)-3
  if i==4 then x,y=x2,y2 end
  line(px,py,x,y,i%2==0 and 7 or 12)
  px,py=x,y
 end
end

-- 5. eat what's smaller, grow.
-- your size is your health!
need=split"0,.6,1,1.5"
add(modes,{
 name="grow!",
 desc="no attack buttons! eat what's\nsmaller than you. get huge",
 nohp=true,
 init=function() k.sz=.7 end,
 upd=function()
  -- big = a bit slower
  local s=1.3-k.sz*.25
  k.vx*=s k.vy*=s
 end,
 crush=function(b)
  if k.sz>=need[b.k+1] then
   k.sz=min(k.sz+.01*(b.k+1),2.5)
   return true
  end
 end,
 eat=function(e) return k.sz>=e.kd*.5+.3 end,
 hurt=function(n)
  k.sz-=.05*n
  if k.sz<.45 then k.hp=0 end
 end,
 heal=function() k.sz=min(k.sz+.05,2.5) end,
 hud=function()
  meter("size",k.sz/2.5,11)
  -- marks: house, office, tower
  for i=2,4 do
   local x=31+48*need[i]/2.5
   line(x,120,x,126,k.sz>=need[i] and 7 or 5)
  end
 end
})

-- 6. momentum: speed is power
add(modes,{
 name="stampede",
 desc="no attack buttons! build up\nspeed and ram everything",
 acc=.09,fric=.97,bounce=.7,
 upd=function()
  local s=speed()
  k.safe=k.safe or s>2.5
  k.atk=s>2.5
  if s>2 then
   add(fx,{x=k.x+rnd(6)-3,y=k.y-rnd(8),dx=0,dy=0,t=8,c=s>2.5 and 10 or 9})
  end
 end,
 crush=function(b)
  local s=speed()
  if s>2 then
   k.vx*=.9 k.vy*=.9
   return b.k<3 or s>2.6
  end
  if s>1 then
   b.hp-=1 b.fl=4
   return b.hp<=0
  end
 end,
 eat=function(e) return speed()>1.5 end,
 hud=function()
  local s=speed()
  meter("speed",s/3,s>2.5 and 10 or s>2 and 9 or 6)
 end
})

function speed()
 return sqrt(k.vx*k.vx+k.vy*k.vy)
end

-->8
-- drawing + hud

function drw_play()
 cls(3)
 -- camera eases toward the
 -- kaiju, never past the edge
 cx+=(mid(0,k.x-64,world-128)-cx)*.2
 cy+=(mid(0,k.y-72,world-128)-cy)*.2
 local sx,sy=0,0
 if shake>0 then
  sx,sy=rnd(shake*2)-shake,rnd(shake*2)-shake
  shake=shake>.5 and shake*.85 or 0
 end
 camera(cx+sx,cy+sy)

 -- roads with dashed lines
 for i=0,world-1,64 do
  rectfill(i,0,i+15,world,5)
  rectfill(0,i,world,i+15,5)
 end
 for i=0,world-1,64 do
  for j=cy\8*8,cy+128,8 do line(i+7,j,i+7,j+3,6) end
  for j=cx\8*8,cx+128,8 do line(j,i+7,j+3,i+7,6) end
 end

 -- buildings behind the kaiju,
 -- then the kaiju, then the
 -- buildings in front of it
 for pass=0,1 do
  for b in all(blds) do
   if (b.y+10<k.y)==(pass==0) and b.x>cx-16 and b.x<cx+128 and b.y>cy-16 and b.y<cy+128 then
    drw_bld(b)
   end
  end
  if pass==0 then
   for d in all(drops) do
    spr(d.s,d.x-4,d.y-4+sin(t())*1.5)
   end
   drw_k()
  end
 end

 for e in all(ens) do
  if e.fl>0 then white() end
  spr(e.kd==1 and 32 or 33+t()*10%2,e.x-4,e.y-4,1,1,e.x>k.x)
  pal()
  if e.stun>0 then print("z",e.x+2,e.y-8-t()*4%4,7) end
 end
 for s in all(shots) do
  spr(s.s,s.x-4,s.y-4,1,1,s.dx<0)
 end
 if mode.drw then mode.drw() end
 for p in all(fx) do
  if p.r then circ(p.x,p.y,p.r*(1-p.t/10),p.c)
  else circfill(p.x,p.y,p.t/6,p.c) end
 end
 for p in all(pops) do
  oprint(p.s,p.x-#p.s*2,p.y,10)
 end

 -- the hud ignores the camera
 camera()
 drw_hud()
 if st=="over" then drw_over() end
end

function drw_bld(b)
 if b.dead then
  if b.k>0 then spr(12,b.x,b.y,2,2) end
  return
 end
 if b.fl>0 then b.fl-=1 white() end
 if b.k==0 then spr(37,b.x+4,b.y+4)
 else spr(bspr[b.k+1],b.x,b.y,2,2) end
 pal()
end

function drw_k()
 local s=k.sz
 local w=16*s
 ovalfill(k.x-6*s,k.y-2*s,k.x+6*s,k.y+2*s,1)
 -- blink while hurt
 if k.inv%4<2 then
  -- glow gold when untouchable
  if k.safe then pal(11,10) pal(3,9) end
  local f=k.atk and 4 or flr(k.fr)%2*2
  sspr(f*8,0,16,16,k.x-w/2,k.y-w-k.z,w,w,k.face<0)
  pal()
 end
end

-- turn every color white
function white()
 for i=1,15 do pal(i,7) end
end

function oprint(s,x,y,c)
 for i=-1,1 do
  for j=-1,1 do print(s,x+i,y+j,0) end
 end
 print(s,x,y,c)
end

function meter(l,f,c)
 print(l,1,121,c)
 rect(30,121,80,125,5)
 rectfill(31,122,31+48*mid(0,f,1),124,c)
end

function drw_hud()
 rectfill(0,0,127,7,0)
 if not mode.nohp then
  print("hp",1,1,8)
  for i=1,k.mhp do
   rectfill(6+i*4,1,8+i*4,5,i<=k.hp and 8 or 2)
  end
 end
 print(score,58,1,7)
 local s=secs
 print(s\60 ..":"..(s%60<10 and "0" or "")..s%60,108,1,6)
 rectfill(0,119,127,127,0)
 mode.hud()
 if bt>0 then
  bt-=1 oprint(bn,64-#bn*2,30,10)
 end
end

function drw_over()
 rectfill(24,40,103,84,0)
 rect(24,40,103,84,8)
 oprint("rampage over",40,44,8)
 print("score "..score,40,54,7)
 print("best  "..max(best,score),40,62,6)
 if score>best then print("new best!",46,70,10) end
 if ot>45 then print("z: menu",50,77,6) end
end

function drw_title()
 cls(1)
 -- skyline + a kaiju strolling
 for i=0,15 do
  local h=4+(i*37)%10
  rectfill(i*8,127-h,i*8+7,127,0)
 end
 local x=t()*12%160-16
 sspr(t()*4%2\1*16,0,16,16,x,104,16,16)
 oprint("kaiju workshop",36,2,11)
 print("with attack buttons",4,13,9)
 print("no attack buttons",4,47,9)
 print("best",108,13,5)
 for i=1,#modes do
  local y=14+i*8+(i>3 and 10 or 0)
  local on=i==sel
  print((on and "> " or "  ")..modes[i].name,4,y,on and 10 or 6)
  print(dget(i),108,y,on and 7 or 5)
 end
 print(modes[sel].desc,4,84,7)
 print("z or x: start",4,97,6)
end
